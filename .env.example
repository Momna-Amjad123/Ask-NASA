# ---------------------------------------------------------------------------
# Ask-NASA — root environment template
#
# Copy this file to `.env` and fill in real values locally.
# `.env` is git-ignored and must never be committed.
# Do NOT put real secrets in this template.
#
# Variable names only. See docs/ARCHITECTURE.md section 14.
# ---------------------------------------------------------------------------

# Public URL of the backend API (consumed by the frontend).
BACKEND_URL=

# Public URL of the frontend (used by the backend for CORS, etc.).
FRONTEND_URL=
