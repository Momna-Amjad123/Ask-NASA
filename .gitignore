# ---------------------------------------------------------------------------
# Ask-NASA .gitignore
# ---------------------------------------------------------------------------

# Environment / secrets ------------------------------------------------------
.env
.env.*
!.env.example
*.local
secrets/
*.pem
*.key

# Node / frontend ------------------------------------------------------------
node_modules/
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Python / backend -----------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.python-version
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Logs / caches --------------------------------------------------------------
*.log
logs/
.cache/

# OS / editor ----------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
