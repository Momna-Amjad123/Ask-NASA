# ---------------------------------------------------------------------------
# Ask-NASA — backend environment template
#
# Copy this file to `backend/.env` and fill in real values locally.
# `.env` is git-ignored and must never be committed.
# Do NOT put real secrets or valid-looking API keys in this template.
#
# Variable names only. See docs/ARCHITECTURE.md section 14 and
# docs/DATA_SOURCES.md section 3.2 (NASA API key stays server-side).
# ---------------------------------------------------------------------------

# --- LLM (provider-agnostic; see docs/ARCHITECTURE.md section 2.4) ---
# Server-side only. Never expose to the frontend.
LLM_API_KEY=
# Model identifier for the selected provider.
LLM_MODEL=

# --- NASA APIs (see docs/DATA_SOURCES.md) ---
# Server-side only. Register a key at https://api.nasa.gov/.
# Leave empty to fall back to NASA's DEMO_KEY during early experimentation.
NASA_API_KEY=

# --- Service URLs ---
# Frontend origin, used for CORS configuration.
FRONTEND_URL=
